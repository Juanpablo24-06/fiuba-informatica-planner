# demo: fictional browser-local app; standard: Next.js with password and database.
APP_MODE=demo

# Only required for APP_MODE=standard. Never put service tokens in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_DAYS=14
DEMO_LOGIN_ENABLED=false

# External admin integrations. Use one shared token or set per-surface tokens.
EXTERNAL_ADMIN_BEARER_TOKEN=
GPT_ACTIONS_BEARER_TOKEN=
MCP_BEARER_TOKEN=
CRON_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REQUEST_TIMEOUT_MS=32000
OPENROUTER_MAX_TOKENS=1800

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_MS=60000
NVIDIA_MAX_TOKENS=4096

# Memoria semántica opcional. Supabase sigue siendo la copia visible y editable.
MEM0_API_KEY=
MEM0_API_URL=https://api.mem0.ai

CHAT_PERSISTENCE_ENABLED=true
NEXT_PUBLIC_CHAT_PERSISTENCE=true
