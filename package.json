{
  "name": "fiuba-informatica-plan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/app-mode.mjs dev",
    "dev:standard": "node scripts/app-mode.mjs dev standard",
    "dev:demo": "node scripts/app-mode.mjs dev demo",
    "dev:harness": "node scripts/clean-next-webpack-cache.mjs && next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/app-mode.mjs build",
    "build:standard": "node scripts/app-mode.mjs build standard",
    "build:demo": "node scripts/app-mode.mjs build demo",
    "start": "node scripts/app-mode.mjs start",
    "start:standard": "node scripts/app-mode.mjs start standard",
    "start:demo": "node scripts/app-mode.mjs start demo",
    "demo:install": "npm --prefix apps/demo ci",
    "verify:demo": "npm --prefix apps/demo run typecheck && npm --prefix apps/demo test && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:standard",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "harness:smoke": "playwright test tests/e2e/navigation-smoke.spec.ts",
    "e2e:install": "playwright install chromium",
    "seed": "node scripts/seed.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "sb:backup": "bash scripts/backup-supabase.sh",
    "sb:login": "npx --yes supabase@2.112.0 login",
    "sb:link": "npx --yes supabase@2.112.0 link",
    "sb:migrations": "npx --yes supabase@2.112.0 migration list",
    "sb:pull": "npx --yes supabase@2.112.0 db pull",
    "sb:push": "npx --yes supabase@2.112.0 db push"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.112.2",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "googleapis": "^174.0.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "mcp-handler": "^2.1.0",
    "next": "^16.4.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.8",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
